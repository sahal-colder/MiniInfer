# C entry points share the same logical core as native C++ and vLLM callers.
# The mmap-only C pool also serves LD_PRELOAD without depending on libc malloc.
option(INFER_WERROR "Treat C module and ABI warnings as errors" ON)
option(INFER_IO_DLSYM "Build RTLD_NEXT C file adapter" ON)
option(INFER_IO_URING "Build optional liburing C file adapter" ON)
find_package(Threads REQUIRED)

add_library(infer_base STATIC src/base/crc32c.c)
target_include_directories(infer_base PUBLIC
    $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include/c>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/miniinfer>)
add_library(infer_mem STATIC src/cpu/c_pool.c)
target_link_libraries(infer_mem PUBLIC infer_base Threads::Threads)
set_target_properties(infer_base PROPERTIES EXPORT_NAME c_base)
set_target_properties(infer_mem PROPERTIES EXPORT_NAME c_memory)
set(INFER_C_TARGETS infer_base infer_mem)
list(APPEND INFER_INSTALL_TARGETS infer_base infer_mem)

if(INFER_BUILD_C_API)
    add_library(infer_io STATIC src/io/io.c src/io/posix.c)
    target_link_libraries(infer_io PUBLIC infer_base)
    if(INFER_IO_DLSYM)
        target_sources(infer_io PRIVATE src/io/dlsym.c)
        target_compile_definitions(infer_io PRIVATE IF_HAVE_DLSYM=1)
        target_link_libraries(infer_io PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
    endif()
    if(INFER_IO_URING)
        find_path(INFER_C_URING_INCLUDE_DIR liburing.h)
        find_library(INFER_C_URING_LIBRARY uring)
        if(INFER_C_URING_INCLUDE_DIR AND INFER_C_URING_LIBRARY)
            target_sources(infer_io PRIVATE src/io/uring.c)
            target_compile_definitions(infer_io PRIVATE IF_HAVE_URING=1)
            target_include_directories(infer_io PRIVATE ${INFER_C_URING_INCLUDE_DIR})
            target_link_libraries(infer_io PRIVATE ${INFER_C_URING_LIBRARY} Threads::Threads)
        else()
            message(STATUS "liburing unavailable: explicit IF_IO_URING requests return -ENOTSUP")
        endif()
    endif()
    set_target_properties(infer_io PROPERTIES EXPORT_NAME device_io)
    list(APPEND INFER_C_TARGETS infer_io)
    list(APPEND INFER_INSTALL_TARGETS infer_io)

    if(INFER_BUILD_RUNTIME)
        add_library(infer_store STATIC src/c_api/store.cpp src/c_api/runtime.cpp src/c_api/stream.cpp)
        target_link_libraries(infer_store PUBLIC infer_mem infer_io infer_storage)
        add_library(infer_aio STATIC src/c_api/aio.c)
        target_link_libraries(infer_aio PUBLIC infer_store Threads::Threads)
        add_library(infer SHARED src/c_api/abi.c)
        add_library(Infer::c_api ALIAS infer)
        set_target_properties(infer PROPERTIES VERSION 3.0.0 SOVERSION 3 EXPORT_NAME c_api)
        target_include_directories(infer PUBLIC
            $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include/c>
            $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/miniinfer>)
        target_link_libraries(infer PRIVATE
            $<LINK_LIBRARY:WHOLE_ARCHIVE,infer_aio,infer_store,infer_io,infer_mem,infer_base>)
        target_link_options(infer PRIVATE -Wl,--exclude-libs,libinfer_storage.a:libinfer_memory.a
            "-Wl,--version-script=${PROJECT_SOURCE_DIR}/src/c_api/exports.map")
        set_property(TARGET infer APPEND PROPERTY LINK_DEPENDS "${PROJECT_SOURCE_DIR}/src/c_api/exports.map")
        list(APPEND INFER_C_TARGETS infer_store infer_aio infer)
        list(APPEND INFER_INSTALL_TARGETS infer)
    endif()
endif()
install(DIRECTORY include/c/infer DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/miniinfer)

if(INFER_BUILD_PRELOAD)
    add_library(infer_preload SHARED src/preload/preload.c)
    target_compile_options(infer_preload PRIVATE
        -fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc -fno-builtin-free)
    target_link_libraries(infer_preload PRIVATE infer_mem ${CMAKE_DL_LIBS})
    target_link_options(infer_preload PRIVATE -Wl,--exclude-libs,ALL -Wl,-z,nodelete)
    set_target_properties(infer_preload PROPERTIES EXPORT_NAME preload)
    list(APPEND INFER_C_TARGETS infer_preload)
    list(APPEND INFER_INSTALL_TARGETS infer_preload)
endif()

foreach(target IN LISTS INFER_C_TARGETS)
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_compile_options(${target} PRIVATE -Wall -Wextra)
    # Interposition requires the standard malloc/free symbols to stay visible.
    if(NOT target STREQUAL "infer_preload")
        target_compile_options(${target} PRIVATE -fvisibility=hidden)
    endif()
    if(INFER_WERROR)
        target_compile_options(${target} PRIVATE -Werror)
    endif()
endforeach()
